set shell := ["bash", "-euo", "pipefail", "-c"]

cover_min := "80"

default: check

# Fast subset of `check`, run by the Claude Code Stop hook when code changed.
fast: fmt-check lint test

fmt:
    golangci-lint fmt

fmt-check:
    golangci-lint fmt --diff

lint:
    golangci-lint run

test:
    go test -race -shuffle=on ./...

# Adapters against real Postgres/NATS (testcontainers, needs Docker).
test-integration:
    go test -race -tags=integration ./...

# Unit-test coverage across packages. Left out of the threshold: cmd/ (wiring
# only), generated code, and infrastructure adapters, which `test-integration` covers.
cover:
    go test -race -shuffle=on -coverpkg=./... -coverprofile=coverage.out ./...
    grep -vE '/cmd/|/sqlcgen/|\.pb\.go:|/adapters/(postgres|nats|grpc)/|/platform/(postgres|nats)/' coverage.out > coverage.logic.out
    go tool cover -func=coverage.logic.out | awk -v min={{cover_min}} '/^total:/ { sub("%", "", $3); if ($3 + 0 < min) { printf "coverage %s%% is below %s%%\n", $3, min; exit 1 } printf "coverage %s%%\n", $3 }'

# Known vulnerabilities in dependencies and the standard library.
vuln:
    go run golang.org/x/vuln/cmd/govulncheck@latest ./...

# AGENTS.md stays small: it is loaded on every agent turn.
agents-md:
    scripts/check-agents-md.sh 150

# Claude Code loads AGENTS.md only through CLAUDE.md's `@AGENTS.md` import.
claude-md:
    scripts/check-claude-md.sh

# Secrets committed anywhere in git history.
secrets:
    gitleaks git --no-banner --redact

# GitHub Actions workflows: injection, unpinned actions, excessive permissions.
workflows:
    zizmor --no-progress --min-severity medium .github/workflows

tidy-check:
    go mod tidy -diff

# Protobuf lint + breaking changes against main; no-op without buf.yaml.
proto:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f buf.yaml ] || exit 0
    buf lint
    if git rev-parse --verify -q origin/main >/dev/null; then buf breaking --against '.git#ref=origin/main'; fi

# Generated code is current; no-op without sqlc.yaml / buf.gen.yaml.
generate-check:
    @if [ -f sqlc.yaml ]; then sqlc diff && sqlc vet; fi
    @if [ -f buf.gen.yaml ]; then buf generate && git diff --exit-code -- api/ internal/; fi

build:
    go build ./...

check: agents-md claude-md fmt-check lint cover vuln secrets workflows tidy-check proto generate-check build
